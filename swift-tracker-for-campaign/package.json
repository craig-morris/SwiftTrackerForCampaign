{
  "name": "swift-tracker-for-campaign",
  "version": "1.0.0",
  "description": "Email tracking framework for transactional emails on Cloudflare Pages",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev public --d1=DB --compatibility-date=2024-01-01",
    "deploy": "wrangler pages deploy public",
    "db:migrate": "wrangler d1 execute swift_tracker_db --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}